#set($body=$ctx.args.message.trim())
#if(!$util.matches("(?s)^.{2,20}$",$name) || !$util.matches("(?s)^.{1,300}$",$body))
  $util.error("닉네임은 2~20자, 메시지는 1~300자로 입력해 주세요.","BadInput")
#end
#set($when=$util.time.nowISO8601())
